# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
# Local dev only. In production (Render), the platform injects PORT itself
# and the start command must bind to it (--port $PORT) — do not hardcode
# 8000 in the start command or anywhere else for production.
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./data/claims.db
# PostgreSQL (production — e.g. Render PostgreSQL "Internal Database URL"):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/claims_db

# ── AI Provider ───────────────────────────────────────────────────────────────
# Default provider: Anthropic Claude Sonnet (cost-efficient — Sonnet, not
# Opus). Switching providers is a configuration-only change — AI_PROVIDER
# selects the concrete AIProvider implementation via app/ai/providers/factory.py;
# no agent or pipeline code needs to change either way.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Gemini (alternate provider — uncomment AI_PROVIDER/AI_MODEL below and set
#    GEMINI_API_KEY to switch back; gemini-flash-latest always points at
#    Google's current default flash model — pin a specific dated version only
#    if you need reproducible behavior across model updates) ─────────────────
# AI_PROVIDER=gemini
# AI_MODEL=gemini-flash-latest
GEMINI_API_KEY=your-gemini-api-key-here

# ── OpenAI (future) ───────────────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins (not comma-separated — must parse as a JSON
# list). In production, set this to the deployed Vercel frontend URL, e.g.:
# CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_FILE_PATH=policy_terms.json

# ── Fraud Detection ───────────────────────────────────────────────────────────
FRAUD_AUTO_REVIEW_THRESHOLD=0.80
