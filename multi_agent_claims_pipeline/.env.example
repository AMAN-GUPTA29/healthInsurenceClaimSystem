# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./data/claims.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/claims_db

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
# gemini-flash-latest always points at Google's current default flash model —
# pin to a specific version (e.g. gemini-2.5-flash) only if you need
# reproducible behavior across model updates. Verified working 2026-08-09;
# some dated versions (gemini-2.5-flash, gemini-2.5-flash-lite) return 404
# "no longer available to new users" depending on when your API key/project
# was created.
AI_MODEL=gemini-flash-latest
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Anthropic (alternate provider — set AI_PROVIDER=anthropic to use) ─────────
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── OpenAI (future) ───────────────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_FILE_PATH=policy_terms.json

# ── Fraud Detection ───────────────────────────────────────────────────────────
FRAUD_AUTO_REVIEW_THRESHOLD=0.80
